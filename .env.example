# ==============================================================================
# SmartLogix - Variables de entorno para Docker Compose
# Copiar este archivo a .env (en la raíz del repo) y completar con tus valores.
# NUNCA subir .env con datos reales a git (ya debe estar en .gitignore).
# ==============================================================================

# ── Base de datos MySQL ──────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esta_password

# ── Azure Entra ID (autenticación MSAL) ─────────────────────────────
# Obtener desde portal.azure.com -> Microsoft Entra ID -> App registrations
AZURE_CLIENT_ID=tu_application_client_id
AZURE_TENANT_ID=tu_directory_tenant_id

# ── URL del frontend (para CORS del API Gateway) ────────────────────
# En local: http://localhost:3000
# En producción: la URL real donde sirvas el frontend
FRONTEND_URL=http://localhost:3000
