# ==============================================================================
# SmartLogix - Variables de entorno para Docker Compose (Local y AWS EC2)
# Copiar este archivo a .env (en la raíz del repo) y completar con tus valores.
# NUNCA subir .env con datos reales a git (ya debe estar en .gitignore).
# ==============================================================================

# ── Host / IP Pública (Local: localhost | AWS EC2: IP Pública de la instancia) ─
HOST_IP=localhost

# ── Base de datos MySQL ──────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambia_esta_password

# ── Azure Entra ID (autenticación OIDC / MSAL) ───────────────────────────────
# Obtener desde portal.azure.com -> Microsoft Entra ID -> App registrations
AZURE_CLIENT_ID=65187167-4bfc-4ef5-a584-4654e7d0612d
AZURE_TENANT_ID=0d03f96b-5542-4d7d-86fe-546f8f471495

# ── URLs de Frontend y Backend (para CORS y Build) ───────────────────────────
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080

# ── Clúster RabbitMQ (2 Nodos) ───────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=smartlogix
RABBITMQ_DEFAULT_PASS=smartlogix123
RABBITMQ_ERLANG_COOKIE=smartlogix_cluster_cookie

# ── Apache Kafka & Kafka-UI ──────────────────────────────────────────────────
KAFKA_UI_PORT=8095
