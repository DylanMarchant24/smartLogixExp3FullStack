# ==============================================================================
# SmartLogix Frontend - Variables de entorno (IDaaS Microsoft Entra ID / Azure AD)
# Copiar a frontend/.env y completar según el entorno (Local o AWS EC2).
# ==============================================================================

# Credenciales OIDC / OAuth2 en Microsoft Entra ID (Azure AD)
REACT_APP_AZURE_CLIENT_ID=054c210b-8c7b-4f88-be71-fb121fd0ed1c
REACT_APP_AZURE_TENANT_ID=a697f9a3-637c-4f25-a999-f3be4e2f9076

# Entorno Local:
REACT_APP_AZURE_REDIRECT_URI=http://localhost:3000
REACT_APP_API_BASE_URL=http://127.0.0.1:8080

# Entorno Cloud (AWS EC2 / API Gateway):
# REACT_APP_AZURE_REDIRECT_URI=http://<EC2_PUBLIC_IP>:3000
# REACT_APP_API_BASE_URL=http://<EC2_PUBLIC_IP>:8085
